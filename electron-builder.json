{
  "appId": "com.batchstudio.batchviewer",
  "productName": "Batch-Viewer",
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "directories": {
    "output": "release"
  },
  "publish": {
    "provider": "github",
    "owner": "ismailjosim",
    "repo": "batch-viewer-project"
  },
  "files": ["dist/**/*", "dist-electron/**/*", "build/**/*"],
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "icon": "build/icons/md.ico",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "icon": "build/icons/md.ico",
        "role": "Editor"
      },
      {
        "ext": "mdown",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "icon": "build/icons/md.ico",
        "role": "Editor"
      },
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "icon": "build/icons/pdf.ico",
        "role": "Editor"
      },
      {
        "ext": "docx",
        "name": "Word Document",
        "description": "Microsoft Word Document",
        "icon": "build/icons/docx.ico",
        "role": "Editor"
      },
      {
        "ext": "txt",
        "name": "Text Document",
        "description": "Plain Text Document",
        "icon": "build/icons/txt.ico",
        "role": "Editor"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Batch-Viewer",
    "uninstallDisplayName": "Batch-Viewer",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "runAfterFinish": true
  },
  "appx": {
    "identityName": "BatchStudio.BatchViewer",
    "applicationId": "BatchViewer",
    "publisherDisplayName": "Ismail",
    "backgroundColor": "#202020"
  }
}
